{
  "$description": "English. Latin stack; Hangul inside English text falls back to the system Korean font.",
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": "{font.stack.latin}" }
    }
  },
  "letter-spacing": {
    "$type": "number",
    "body": { "$value": 0 },
    "heading": { "$value": -0.02 }
  }
}
