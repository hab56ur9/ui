      "6": { "$value": "{color.green.450}" },
      "7": { "$value": "{color.violet.350}" },
      "8": { "$value": "{color.red.350}" }
    },
    "sequential": {
      "$description": "Inverted for dark: the step nearest the surface means low.",
      "1": { "$value": "{color.blue.700}" },
      "2": { "$value": "{color.blue.600}" },
      "3": { "$value": "{color.blue.500}" },
      "4": { "$value": "{color.blue.400}" },
      "5": { "$value": "{color.blue.300}" },
      "6": { "$value": "{color.blue.200}" },
      "7": { "$value": "{color.blue.100}" }
