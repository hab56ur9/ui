{
  "name": "ui",
  "version": "0.3.0-alpha.11",
  "private": true,
  "type": "module",
  "homepage": "https://hab56ur9.github.io/ui/",
  "exports": {
    ".": "./src/lib/index.ts",
    "./components.json": "./dist/components.json",
    "./spec.schema.json": "./dist/spec.schema.json"
  },
  "files": [
    "src/lib",
    "dist",
    "assets",
    "bin"
  ],
  "scripts": {
    "tokens": "node scripts/build.mjs && node scripts/components.mjs",
    "dev": "node scripts/build.mjs && node scripts/components.mjs && vite",
    "build": "node scripts/build.mjs && node scripts/components.mjs && npm run build:lib && vite build",
    "typecheck": "tsc",
    "lint": "node scripts/lint.mjs",
    "test": "node --test scripts/*.test.mjs",
    "check": "node scripts/build.mjs && node scripts/components.mjs && node scripts/lint.mjs && node --test scripts/*.test.mjs && tsc && npm run build:lib && vite build",
    "build:lib": "vite build -c vite.lib.config.ts",
    "serve": "node bin/ui.mjs serve",
    "check:slides": "node scripts/slides-check.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "bin": {
    "ui": "bin/ui.mjs"
  }
}
