  "formats": {
    "full": {
      "description": "Whole numbers with grouping, such as step counts.",
      "style": "number",
      "digits": 0
    },
    "minutes": {
      "description": "Minutes of activity.",
      "style": "number",
      "digits": 0,
      "unit": "min"
    },
    "hours": {
      "description": "Hours of sleep with one decimal.",
      "style": "number",
      "digits": 1,
      "unit": "h"
    },
    "kcal": {
      "description": "Calories.",
      "style": "number",
      "digits": 0,
      "unit": "kcal"
    },
    "km": {
      "description": "Distance with one decimal.",
      "style": "number",
      "digits": 1,
      "unit": "km"
    },
    "bpm": {
      "description": "Heart rate.",
      "style": "number",
      "digits": 0,
      "unit": "bpm"
    },
    "date": {
      "description": "Short date with weekday.",
      "style": "date"
    }
  },
  "actions": {
    "start-workout": {
      "description": "Starts recording a workout of the chosen kind and keeps recording with the screen off.",
      "params": {
        "kind": "walk | run"
      }
    },
    "select-day": {
      "description": "Shows the workouts of the tapped calendar day.",
      "params": {
        "value": "the tapped date"
      }
    },
    "manage-devices": {
      "description": "Opens device settings to pair or remove a watch."
    }
  },
  "screens": {
    "today": {
      "description": "The first screen. It shows today's activity at a glance and the way into a workout.",
      "title": "Today's activity",
      "lede": "Today's steps, activity, calories and sleep, with the way into a workout.",
      "actions": [
        {
          "label": "Start workout",
          "variant": "primary",
          "action": {
            "name": "open",
            "params": {
              "overlay": "start"
            }
          }
        }
      ],
      "widgets": [
        {
          "id": "steps",
          "title": "Steps",
          "subtitle": "Today · vs 7-day average",
          "w": 3,
          "h": 2,
          "description": "Today's steps with the change from the 7-day average and a 14-day trend.",
          "content": {
            "type": "Stat",
            "props": {
              "value": {
                "$data": "steps.today",
                "$format": "full"
              },
              "delta": {
                "change": {
                  "$data": "steps.delta"
                },
                "label": "vs usual"
              },
              "trend": {
                "$data": "steps.trend"
              }
            }
          }
        },
        {
          "id": "active",
          "title": "Active time",
          "subtitle": "Today",
          "w": 3,
          "h": 2,
          "description": "Today's active minutes with the change from the 7-day average.",
          "content": {
            "type": "Stat",
            "props": {
              "value": {
                "$data": "active.today",
                "$format": "minutes"
              },
              "delta": {
                "change": {
                  "$data": "active.delta"
                },
                "label": "vs usual"
              }
            }
          }
        },
        {
          "id": "calories",
          "title": "Calories burned",
          "subtitle": "Today",
          "w": 3,
          "h": 2,
          "description": "Today's calories burned with the change from the 7-day average.",
          "content": {
            "type": "Stat",
            "props": {
              "value": {
                "$data": "calories.today",
                "$format": "kcal"
              },
              "delta": {
                "change": {
                  "$data": "calories.delta"
                },
                "label": "vs yesterday"
              }
            }
          }
        },
        {
          "id": "sleep",
          "title": "Sleep",
          "subtitle": "Last night",
          "w": 3,
          "h": 2,
          "description": "Last night's sleep with the change from the 7-night average.",
          "content": {
            "type": "Stat",
            "props": {
              "value": {
                "$data": "sleep.last",
                "$format": "hours"
              },
              "delta": {
                "change": {
                  "$data": "sleep.delta"
                },
                "label": "vs usual"
              }
            }
          }
        },
        {
          "id": "heart",
          "title": "Heart rate",
          "subtitle": "Last 30 days · daily",
          "w": 8,
          "h": 4,
          "description": "Average and resting heart rate over 30 days. On Today, tapping it opens Trends.",
          "action": {
            "name": "navigate",
            "params": {
              "screen": "trends"
            }
          },
          "content": {
            "type": "LineChart",
            "props": {
              "series": [
                {
                  "name": "Average",
                  "color": 2,
                  "points": {
                    "$data": "heart.average"
                  }
                },
                {
                  "name": "Resting",
                  "color": 1,
                  "points": {
                    "$data": "heart.resting"
                  }
                }
              ],
              "format": {
                "axis": {
                  "$format": "bpm"
                }
              }
            }
          }
        },
        {
          "id": "goal",
          "title": "Today's goal",
          "w": 4,
          "h": 4,
          "description": "How far today's step goal is, with a suggestion to close the gap. Tapping it opens the goal sheet.",
          "action": {
            "name": "open",
            "params": {
              "overlay": "goal"
            }
          },
          "content": [
            {
              "type": "Callout",
              "props": {
                "tone": "good",
                "title": "2,140 steps to go"
              },
              "children": "A 20-minute evening walk gets you to the 10,000-step goal."
            },
            {
              "type": "Button",
              "props": {
                "onClick": {
                  "$action": {
                    "name": "start-workout",
                    "params": {
                      "kind": "walk"
                    }
                  }
                }
              },
              "children": "Start a walk"
            }
          ]
        },
        {
          "id": "weekly",
          "title": "Weekly active time",
          "subtitle": "Last 8 weeks",
          "w": 5,
          "h": 4,
          "description": "Active minutes per week for 8 weeks.",
          "content": {
            "type": "BarChart",
            "props": {
              "name": "Active time",
              "points": {
                "$data": "active.weekly"
              },
              "format": {
                "axis": {
                  "$format": "minutes"
                },
                "value": {
                  "$format": "minutes"
                }
              }
            }
          }
        },
        {
          "id": "workouts",
          "title": "Recent workouts",
          "subtitle": "Last 5 sessions",
          "w": 7,
          "h": 4,
          "description": "The last five workouts. On Today, tapping it opens Workouts.",
          "action": {
            "name": "navigate",
            "params": {
              "screen": "workouts"
            }
          },
          "content": {
            "type": "DataTable",
            "props": {
              "columns": [
                {
                  "label": "Date",
                  "numeric": true
                },
                {
                  "label": "Workouts"
                },
                {
                  "label": "Time",
                  "numeric": true
                },
                {
                  "label": "Distance",
                  "numeric": true
                },
                {
                  "label": "Calories",
                  "numeric": true
                }
              ],
              "rows": {
                "$each": {
                  "$data": "workouts.recent"
                },
                "$as": [
                  {
                    "$field": "date",
                    "$format": "date"
                  },
                  {
                    "$field": "kind",
                    "$labels": {
                      "run": "Run",
                      "ride": "Ride",
                      "strength": "Strength",
                      "yoga": "Yoga"
                    }
                  },
                  {
                    "$field": "minutes",
                    "$format": "minutes"
                  },
                  {
                    "$field": "distance",
                    "$format": "km"
                  },
                  {
                    "$field": "calories",
                    "$format": "kcal"
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "workouts": {
      "description": "Workout history as a table and a calendar, with weekly totals.",
      "title": "Workouts",
      "lede": "Recent sessions and weekly active time.",
      "actions": [
