{
  "version": 3,
  "app": "핏노트",
  "start": "today",
  "nav": [
    {
      "id": "today",
      "label": "오늘",
      "icon": "home"
    },
    {
      "id": "workouts",
      "label": "운동",
      "icon": "calendar"
    },
    {
      "id": "trends",
      "label": "추세",
      "icon": "chart-line"
    },
    {
      "id": "profile",
      "label": "내 정보",
      "icon": "user"
    }
  ],
  "screens": {
    "today": {
      "title": "오늘의 활동",
      "lede": "메뉴, 화면, 모달과 시트, 버튼과 위젯을 눌렀을 때의 동작까지 모두 서버 응답(screen.json)이 정합니다.",
      "actions": [
        {
          "label": "운동 시작",
          "variant": "primary",
          "action": {
            "name": "open",
            "params": {
              "overlay": "start"
            }
          }
        }
      ],
      "widgets": [
        {
          "id": "steps",
          "title": "걸음 수",
          "subtitle": "오늘 · 최근 7일 평균 대비",
          "w": 3,
          "h": 2,
          "content": {
            "type": "Stat",
            "props": {
              "value": {
                "$data": "steps.today",
                "$format": "full"
              },
              "delta": {
                "change": {
                  "$data": "steps.delta"
                },
                "label": "평소보다"
              },
              "trend": {
                "$data": "steps.trend"
              }
            }
          }
        },
        {
          "id": "active",
          "title": "활동 시간",
          "subtitle": "오늘",
          "w": 3,
          "h": 2,
          "content": {
            "type": "Stat",
            "props": {
              "value": {
                "$data": "active.today",
                "$format": "minutes"
              },
              "delta": {
                "change": {
                  "$data": "active.delta"
                },
                "label": "평소보다"
              }
            }
          }
        },
        {
          "id": "calories",
          "title": "소모 칼로리",
          "subtitle": "오늘",
          "w": 3,
          "h": 2,
          "content": {
            "type": "Stat",
            "props": {
              "value": {
                "$data": "calories.today",
                "$format": "kcal"
              },
              "delta": {
                "change": {
                  "$data": "calories.delta"
                },
                "label": "어제보다"
              }
            }
          }
        },
        {
          "id": "sleep",
          "title": "수면",
          "subtitle": "어젯밤",
          "w": 3,
          "h": 2,
          "content": {
            "type": "Stat",
            "props": {
              "value": {
                "$data": "sleep.last",
                "$format": "hours"
              },
              "delta": {
                "change": {
                  "$data": "sleep.delta"
                },
                "label": "평소보다"
              }
            }
          }
        },
        {
          "id": "heart",
          "title": "심박수",
          "subtitle": "최근 30일 · 일간",
          "w": 8,
          "h": 4,
          "content": {
            "type": "LineChart",
            "props": {
              "series": [
                {
                  "name": "평균 심박",
                  "color": 2,
                  "points": {
                    "$data": "heart.average"
                  }
                },
                {
                  "name": "안정 시 심박",
                  "color": 1,
                  "points": {
                    "$data": "heart.resting"
                  }
                }
              ],
              "format": {
                "axis": {
                  "$format": "bpm"
                }
              }
            }
          },
          "action": {
            "name": "navigate",
            "params": {
              "screen": "trends"
            }
          }
        },
        {
          "id": "goal",
          "title": "오늘의 목표",
          "w": 4,
          "h": 4,
          "content": [
            {
              "type": "Callout",
              "props": {
                "tone": "good",
                "title": "목표까지 2,140걸음"
              },
              "children": "저녁 산책 20분이면 하루 목표 10,000걸음을 채웁니다."
            },
            {
              "type": "Button",
              "props": {
                "onClick": {
                  "$action": {
                    "name": "start-workout",
                    "params": {
                      "kind": "walk"
                    }
                  }
                }
              },
              "children": "산책 기록 시작"
            }
          ],
          "action": {
            "name": "open",
            "params": {
              "overlay": "goal"
            }
          }
        },
        {
          "id": "weekly",
          "title": "주간 활동 시간",
          "subtitle": "최근 8주",
          "w": 5,
          "h": 4,
          "content": {
            "type": "BarChart",
            "props": {
              "name": "활동 시간",
              "points": {
                "$data": "active.weekly"
              },
              "format": {
                "axis": {
                  "$format": "minutes"
                },
                "value": {
                  "$format": "minutes"
                }
              }
            }
          }
        },
        {
          "id": "workouts",
          "title": "최근 운동",
          "subtitle": "마지막 5회",
          "w": 7,
          "h": 4,
          "content": {
            "type": "DataTable",
            "props": {
              "columns": [
                {
                  "label": "날짜",
                  "numeric": true
                },
                {
                  "label": "운동"
                },
                {
                  "label": "시간",
                  "numeric": true
                },
                {
                  "label": "거리",
                  "numeric": true
                },
                {
                  "label": "칼로리",
                  "numeric": true
                }
              ],
              "rows": {
                "$each": {
                  "$data": "workouts.recent"
                },
                "$as": [
                  {
                    "$field": "date",
                    "$format": "date"
                  },
                  {
                    "$field": "kind",
                    "$labels": {
                      "run": "달리기",
                      "ride": "자전거",
                      "strength": "근력",
                      "yoga": "요가"
                    }
                  },
                  {
                    "$field": "minutes",
                    "$format": "minutes"
                  },
                  {
                    "$field": "distance",
                    "$format": "km"
                  },
                  {
                    "$field": "calories",
                    "$format": "kcal"
                  }
                ]
              }
            }
          },
          "action": {
            "name": "navigate",
            "params": {
              "screen": "workouts"
            }
          }
        }
      ]
    },
    "workouts": {
      "title": "운동",
      "lede": "최근 기록과 주간 활동 시간입니다.",
      "actions": [
        {
          "label": "운동 시작",
          "variant": "primary",
          "action": {
            "name": "open",
            "params": {
              "overlay": "start"
            }
          }
        }
      ],
      "widgets": [
        {
          "id": "workouts",
          "title": "최근 운동",
          "subtitle": "마지막 5회",
          "w": 12,
          "h": 5,
          "content": {
            "type": "DataTable",
            "props": {
              "columns": [
                {
                  "label": "날짜",
                  "numeric": true
                },
                {
                  "label": "운동"
                },
                {
                  "label": "시간",
                  "numeric": true
                },
                {
                  "label": "거리",
                  "numeric": true
                },
                {
                  "label": "칼로리",
                  "numeric": true
                }
              ],
              "rows": {
                "$each": {
                  "$data": "workouts.recent"
                },
                "$as": [
                  {
                    "$field": "date",
                    "$format": "date"
                  },
                  {
                    "$field": "kind",
                    "$labels": {
                      "run": "달리기",
                      "ride": "자전거",
                      "strength": "근력",
                      "yoga": "요가"
                    }
                  },
                  {
                    "$field": "minutes",
                    "$format": "minutes"
                  },
                  {
                    "$field": "distance",
                    "$format": "km"
                  },
                  {
                    "$field": "calories",
                    "$format": "kcal"
                  }
                ]
              }
            }
          }
        },
        {
          "id": "calendar",
          "title": "운동 달력",
          "subtitle": "점은 운동한 날 · 날짜를 누르면 서버에 알림",
          "w": 6,
          "h": 5,
          "content": {
            "type": "Calendar",
            "props": {
              "today": {
                "$data": "today"
              },
              "marks": {
                "$data": "workouts.days"
              },
              "onChange": {
                "$action": {
                  "name": "select-day"
                }
              }
            }
          }
        },
        {
          "id": "weekly",
          "title": "주간 활동 시간",
          "subtitle": "최근 8주",
          "w": 6,
          "h": 5,
          "content": {
            "type": "BarChart",
            "props": {
              "name": "활동 시간",
              "points": {
                "$data": "active.weekly"
              },
              "format": {
                "axis": {
                  "$format": "minutes"
                },
                "value": {
                  "$format": "minutes"
                }
              }
            }
          }
        }
      ]
    },
    "trends": {
      "title": "추세",
      "lede": "심박수와 걸음 수의 흐름입니다.",
      "widgets": [
        {
          "id": "heart",
          "title": "심박수",
          "subtitle": "최근 30일 · 일간",
          "w": 12,
          "h": 4,
          "content": {
            "type": "LineChart",
            "props": {
              "series": [
                {
                  "name": "평균 심박",
                  "color": 2,
                  "points": {
                    "$data": "heart.average"
                  }
                },
                {
                  "name": "안정 시 심박",
                  "color": 1,
                  "points": {
                    "$data": "heart.resting"
                  }
                }
              ],
              "format": {
                "axis": {
                  "$format": "bpm"
                }
              }
            }
          }
        },
        {
          "id": "steps",
          "title": "걸음 수",
          "subtitle": "오늘 · 최근 7일 평균 대비",
          "w": 6,
          "h": 3,
          "content": {
            "type": "Stat",
            "props": {
              "value": {
                "$data": "steps.today",
                "$format": "full"
              },
              "delta": {
                "change": {
                  "$data": "steps.delta"
                },
                "label": "평소보다"
              },
              "trend": {
                "$data": "steps.trend"
              }
            }
          }
        },
        {
          "id": "active",
          "title": "활동 시간",
          "subtitle": "오늘",
          "w": 6,
          "h": 3,
          "content": {
            "type": "Stat",
            "props": {
              "value": {
                "$data": "active.today",
                "$format": "minutes"
              },
              "delta": {
                "change": {
                  "$data": "active.delta"
                },
                "label": "평소보다"
              }
            }
          }
        }
      ]
    },
    "profile": {
      "title": "내 정보",
      "widgets": [
        {
          "id": "sleep",
          "title": "수면",
          "subtitle": "어젯밤",
          "w": 6,
          "h": 2,
          "content": {
            "type": "Stat",
            "props": {
              "value": {
                "$data": "sleep.last",
                "$format": "hours"
              },
              "delta": {
                "change": {
                  "$data": "sleep.delta"
                },
                "label": "평소보다"
              }
            }
          }
        },
        {
          "id": "calories",
          "title": "소모 칼로리",
          "subtitle": "오늘",
          "w": 6,
          "h": 2,
          "content": {
            "type": "Stat",
            "props": {
              "value": {
                "$data": "calories.today",
                "$format": "kcal"
              },
              "delta": {
                "change": {
                  "$data": "calories.delta"
                },
                "label": "어제보다"
              }
            }
          }
        },
        {
          "id": "device",
          "title": "연결된 기기",
          "w": 12,
          "h": 3,
          "content": [
            {
              "type": "Callout",
              "props": {
                "tone": "info",
                "title": "애플 워치"
              },
              "children": "마지막 동기화 5분 전. 심박수와 걸음 수를 가져옵니다."
            },
            {
              "type": "Button",
              "props": {
                "onClick": {
                  "$action": {
                    "name": "manage-devices"
                  }
                }
              },
              "children": "기기 관리"
            }
          ]
        }
      ]
    }
  },
  "overlays": {
    "start": {
      "kind": "modal",
      "title": "운동 시작",
      "description": "어떤 운동을 기록할까요?",
      "body": "시작하면 휴대폰 화면을 꺼도 기록이 이어집니다.",
      "actions": [
        {
          "label": "취소",
          "action": {
            "name": "close"
          }
        },
        {
          "label": "걷기",
          "action": {
            "name": "start-workout",
            "params": {
              "kind": "walk"
            },
            "close": true
          }
        },
        {
          "label": "달리기",
          "variant": "primary",
          "action": {
            "name": "start-workout",
            "params": {
              "kind": "run"
            },
            "close": true
          }
        }
      ]
    },
    "goal": {
      "kind": "sheet",
      "title": "오늘의 목표",
      "description": "목표까지 2,140걸음 남았습니다.",
      "body": "저녁 산책 20분이면 하루 목표 10,000걸음을 채웁니다. 목표는 내 정보에서 바꿀 수 있습니다.",
      "actions": [
        {
          "label": "목표 바꾸기",
          "action": {
            "name": "navigate",
            "params": {
              "screen": "profile"
            },
            "close": true
          }
        },
        {
          "label": "산책 기록 시작",
          "variant": "primary",
          "action": {
            "name": "start-workout",
            "params": {
              "kind": "walk"
            },
            "close": true
          }
        }
      ]
    }
  }
}
