                  "numeric": true
                }
              ],
              "rows": {
                "$each": {
                  "$data": "workouts.recent"
                },
                "$as": [
                  {
                    "$field": "date",
                    "$format": "date"
                  },
                  {
                    "$field": "kind",
                    "$labels": {
                      "run": "달리기",
                      "ride": "자전거",
                      "strength": "근력",
                      "yoga": "요가"
                    }
                  },
                  {
                    "$field": "minutes",
                    "$format": "minutes"
                  },
                  {
                    "$field": "distance",
                    "$format": "km"
                  },
                  {
                    "$field": "calories",
                    "$format": "kcal"
                  }
                ]
              }
            }
          }
        },
        {
          "id": "calendar",
          "title": "운동 달력",
          "subtitle": "점은 운동한 날 · 날짜를 누르면 서버에 알림",
          "w": 6,
          "h": 5,
          "description": "운동한 날에 점이 찍히고, 날짜를 누르면 select-day가 실행된다.",
          "content": {
            "type": "Calendar",
            "props": {
              "today": {
                "$data": "today"
              },
              "marks": {
                "$data": "workouts.days"
              },
              "onChange": {
                "$action": {
                  "name": "select-day"
                }
              }
            }
          }
        },
        {
          "id": "weekly",
          "title": "주간 활동 시간",
          "subtitle": "최근 8주",
          "w": 6,
          "h": 5,
          "description": "8주 동안 주별 활동 시간.",
          "content": {
            "type": "BarChart",
            "props": {
              "name": "활동 시간",
              "points": {
                "$data": "active.weekly"
              },
              "format": {
                "axis": {
                  "$format": "minutes"
                },
                "value": {
                  "$format": "minutes"
                }
              }
            }
          }
        }
      ]
    },
    "trends": {
      "description": "심박수, 걸음 수, 활동의 긴 흐름.",
      "title": "추세",
      "lede": "심박수와 걸음 수의 흐름이에요.",
      "widgets": [
        {
          "id": "heart",
          "title": "심박수",
          "subtitle": "최근 30일 · 일별",
          "w": 12,
          "h": 4,
          "description": "30일 동안의 평균·안정 심박수. 오늘 화면에서 누르면 추세 화면으로 간다.",
          "content": {
            "type": "LineChart",
            "props": {
              "series": [
                {
                  "name": "평균",
                  "color": 2,
                  "points": {
                    "$data": "heart.average"
                  }
                },
                {
                  "name": "안정",
                  "color": 1,
                  "points": {
                    "$data": "heart.resting"
                  }
                }
              ],
              "format": {
                "axis": {
                  "$format": "bpm"
                }
              }
            }
          }
        },
        {
          "id": "steps",
          "title": "걸음 수",
          "subtitle": "오늘 · 7일 평균 대비",
          "w": 6,
          "h": 3,
          "description": "오늘 걸음 수와 7일 평균 대비 변화, 14일 추이.",
          "content": {
            "type": "Stat",
            "props": {
              "value": {
                "$data": "steps.today",
                "$format": "full"
              },
              "delta": {
                "change": {
                  "$data": "steps.delta"
                },
                "label": "평소 대비"
              },
              "trend": {
                "$data": "steps.trend"
              }
            }
          }
        },
        {
          "id": "active",
          "title": "활동 시간",
          "subtitle": "오늘",
          "w": 6,
          "h": 3,
          "description": "오늘 활동 시간과 7일 평균 대비 변화.",
          "content": {
            "type": "Stat",
            "props": {
              "value": {
                "$data": "active.today",
                "$format": "minutes"
              },
              "delta": {
                "change": {
                  "$data": "active.delta"
                },
                "label": "평소 대비"
              }
            }
          }
        }
      ]
    },
    "profile": {
      "description": "개인 요약과 연결된 기기.",
      "title": "프로필",
      "widgets": [
        {
          "id": "sleep",
          "title": "수면",
          "subtitle": "지난밤",
          "w": 6,
          "h": 2,
          "description": "지난밤 수면 시간과 7일 평균 대비 변화.",
          "content": {
            "type": "Stat",
            "props": {
              "value": {
                "$data": "sleep.last",
                "$format": "hours"
              },
              "delta": {
                "change": {
                  "$data": "sleep.delta"
                },
                "label": "평소 대비"
              }
            }
          }
        },
        {
          "id": "calories",
          "title": "소모 칼로리",
          "subtitle": "오늘",
          "w": 6,
          "h": 2,
          "description": "오늘 소모 칼로리와 7일 평균 대비 변화.",
          "content": {
            "type": "Stat",
            "props": {
              "value": {
                "$data": "calories.today",
                "$format": "kcal"
              },
              "delta": {
                "change": {
                  "$data": "calories.delta"
                },
                "label": "어제 대비"
              }
            }
          }
        },
        {
          "id": "device",
          "title": "연결된 기기",
          "w": 12,
          "h": 3,
          "description": "연결된 워치와 동기화 상태, 기기 관리로 가는 길.",
          "content": [
            {
              "type": "Callout",
              "props": {
                "tone": "info",
                "title": "Apple Watch"
              },
              "children": "5분 전에 동기화했어요. 심박수와 걸음 수를 여기서 받아요."
            },
            {
              "type": "Button",
              "props": {
                "onClick": {
                  "$action": {
                    "name": "manage-devices"
                  }
                }
              },
              "children": "기기 관리"
            }
          ]
        }
      ]
    }
  },
  "overlays": {
    "start": {
      "kind": "modal",
      "title": "Start workout",
      "description": "Asks which workout to record before starting.",
      "lede": "Which workout should we record?",
      "body": "Once started, recording continues even with the screen off.",
      "actions": [
        {
          "label": "Cancel",
          "action": {
            "name": "close"
          }
        },
        {
          "label": "Walk",
          "action": {
            "name": "start-workout",
            "params": {
              "kind": "walk"
            },
            "close": true
          }
        },
        {
          "label": "Run",
          "variant": "primary",
          "action": {
            "name": "start-workout",
            "params": {
              "kind": "run"
            },
            "close": true
          }
        }
      ]
    },
    "goal": {
      "kind": "sheet",
      "title": "오늘의 목표",
      "description": "오늘의 목표를 설명하고 걷기 시작이나 목표 변경을 권한다.",
      "lede": "목표까지 2,140걸음 남았어요.",
      "body": "저녁에 20분만 걸으면 10,000걸음을 채워요. 목표는 프로필에서 바꿀 수 있어요.",
      "actions": [
        {
          "label": "목표 바꾸기",
          "action": {
            "name": "navigate",
            "params": {
              "screen": "profile"
            },
            "close": true
          }
        },
        {
          "label": "걷기 시작",
          "variant": "primary",
          "action": {
            "name": "start-workout",
            "params": {
              "kind": "walk"
            },
            "close": true
          }
        }
      ]
    }
  }
}
