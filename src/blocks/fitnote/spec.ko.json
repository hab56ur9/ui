  "screens": {
    "today": {
      "description": "첫 화면. 오늘의 활동을 한눈에 보여 주고 운동을 시작하는 길을 둔다.",
      "title": "오늘의 활동",
      "lede": "오늘의 걸음 수, 활동, 칼로리, 수면과 운동 시작 버튼이에요.",
      "actions": [
        {
          "label": "운동 시작",
          "variant": "primary",
          "action": {
            "name": "open",
            "params": {
              "overlay": "start"
            }
          }
        }
      ],
      "widgets": [
        {
          "id": "steps",
          "title": "걸음 수",
          "subtitle": "오늘 · 7일 평균 대비",
          "w": 3,
          "h": 2,
          "description": "오늘 걸음 수와 7일 평균 대비 변화, 14일 추이.",
          "content": {
            "type": "Stat",
            "props": {
              "value": {
                "$data": "steps.today",
                "$format": "full"
              },
              "delta": {
                "change": {
                  "$data": "steps.delta"
                },
                "label": "평소 대비"
              },
              "trend": {
                "$data": "steps.trend"
              }
            }
          }
        },
        {
          "id": "active",
          "title": "활동 시간",
          "subtitle": "오늘",
          "w": 3,
          "h": 2,
          "description": "오늘 활동 시간과 7일 평균 대비 변화.",
          "content": {
            "type": "Stat",
            "props": {
              "value": {
                "$data": "active.today",
                "$format": "minutes"
              },
              "delta": {
                "change": {
                  "$data": "active.delta"
                },
                "label": "평소 대비"
              }
            }
          }
        },
        {
          "id": "calories",
          "title": "소모 칼로리",
          "subtitle": "오늘",
          "w": 3,
          "h": 2,
          "description": "오늘 소모 칼로리와 7일 평균 대비 변화.",
          "content": {
            "type": "Stat",
            "props": {
              "value": {
                "$data": "calories.today",
                "$format": "kcal"
              },
              "delta": {
                "change": {
                  "$data": "calories.delta"
                },
                "label": "어제 대비"
              }
            }
          }
        },
        {
          "id": "sleep",
          "title": "수면",
          "subtitle": "지난밤",
          "w": 3,
          "h": 2,
          "description": "지난밤 수면 시간과 7일 평균 대비 변화.",
          "content": {
            "type": "Stat",
            "props": {
              "value": {
                "$data": "sleep.last",
                "$format": "hours"
              },
              "delta": {
                "change": {
                  "$data": "sleep.delta"
                },
                "label": "평소 대비"
              }
            }
          }
        },
        {
          "id": "heart",
          "title": "심박수",
          "subtitle": "최근 30일 · 일별",
          "w": 8,
          "h": 4,
          "description": "30일 동안의 평균·안정 심박수. 오늘 화면에서 누르면 추세 화면으로 간다.",
          "action": {
            "name": "navigate",
            "params": {
              "screen": "trends"
            }
          },
          "content": {
            "type": "LineChart",
            "props": {
              "series": [
                {
                  "name": "평균",
                  "color": 2,
                  "points": {
                    "$data": "heart.average"
                  }
                },
                {
                  "name": "안정",
                  "color": 1,
                  "points": {
                    "$data": "heart.resting"
                  }
                }
              ],
              "format": {
                "axis": {
                  "$format": "bpm"
                }
              }
            }
          }
        },
        {
          "id": "goal",
          "title": "오늘의 목표",
          "w": 4,
          "h": 4,
          "description": "오늘 걸음 목표까지 남은 양과 채우는 방법. 누르면 목표 시트가 열린다.",
          "action": {
            "name": "open",
            "params": {
              "overlay": "goal"
            }
          },
          "content": [
            {
              "type": "Callout",
              "props": {
                "tone": "good",
                "title": "목표까지 2,140걸음"
              },
              "children": "저녁에 20분 걸으면 10,000걸음 목표를 채워요."
            },
            {
              "type": "Button",
              "props": {
                "onClick": {
                  "$action": {
                    "name": "start-workout",
                    "params": {
                      "kind": "walk"
                    }
                  }
                }
              },
              "children": "걷기 시작"
            }
          ]
        },
        {
          "id": "weekly",
          "title": "주간 활동 시간",
          "subtitle": "최근 8주",
          "w": 5,
          "h": 4,
          "description": "8주 동안 주별 활동 시간.",
          "content": {
            "type": "BarChart",
            "props": {
              "name": "활동 시간",
              "points": {
                "$data": "active.weekly"
              },
              "format": {
                "axis": {
                  "$format": "minutes"
                },
                "value": {
                  "$format": "minutes"
                }
              }
            }
          }
        },
        {
          "id": "workouts",
          "title": "최근 운동",
          "subtitle": "최근 5회",
          "w": 7,
          "h": 4,
          "description": "최근 운동 다섯 건. 오늘 화면에서 누르면 운동 화면으로 간다.",
          "action": {
            "name": "navigate",
            "params": {
              "screen": "workouts"
            }
          },
          "content": {
            "type": "DataTable",
            "props": {
              "columns": [
                {
                  "label": "날짜",
                  "numeric": true
                },
                {
                  "label": "운동"
                },
                {
                  "label": "시간",
                  "numeric": true
                },
                {
                  "label": "거리",
                  "numeric": true
                },
                {
                  "label": "칼로리",
                  "numeric": true
                }
              ],
              "rows": {
                "$each": {
                  "$data": "workouts.recent"
                },
                "$as": [
                  {
                    "$field": "date",
                    "$format": "date"
                  },
                  {
                    "$field": "kind",
                    "$labels": {
                      "run": "달리기",
                      "ride": "자전거",
                      "strength": "근력",
                      "yoga": "요가"
                    }
                  },
                  {
                    "$field": "minutes",
                    "$format": "minutes"
                  },
                  {
                    "$field": "distance",
                    "$format": "km"
                  },
                  {
                    "$field": "calories",
                    "$format": "kcal"
                  }
                ]
              }
            }
          }
        }
      ]
    },
