{"version":"0.3.0-alpha.2","homepage":"https://hab56ur9.github.io/ui/","modes":{"theme":["light","dark"],"medium":["app","doc","slide"],"lang":["en","ko"]},"media":{"app":"Dense product UI: dashboards, tools, widgets.","doc":"Long-form reading: technical pages, specs, reports.","slide":"Projected decks: large type, generous space."},"groups":{"color":"Raw palette. Step numbers follow OKLab lightness: step ≈ (1 − L) × 1000, rounded to 50.","color.lime-gray":"Neutral steps tinted toward the lime hue (OKLCH hue 136, chroma 0.014 to 0.018). The lime preset's sub color draws from it.","color.sky-gray":"Neutral steps tinted toward the sky hue (OKLCH hue 237, chroma 0.014 to 0.018). The sky preset's sub color draws from it.","color.lime":"Brand light green (OKLCH hue ≈ 132), kept apart from the status green at hue ≈ 143.","space":"4px grid. The key is the multiple of 4.","font.stack":"Font stacks per writing system. A lang file picks one as font.family.sans; adding a language adds a stack here and a file in tokens/lang.","chart":"Mark specs shared by every chart, independent of theme and medium.","icon":"Icons sit on a 24 grid and draw with currentColor, so they take the text color around them.","layer":"Stacking order for fixed layers. Modals, sheets and toasts render in the browser top layer instead.","color.bg":"Light surfaces sit a step below white so large areas stay calm: page 76%, surface 83%, raised 87% of white luminance.","color.main":"Main color of the preset: light green by default. Primary buttons fill with it and carry dark text; links, focus rings, current items and emphasized data use the deeper default so they stay readable on light surfaces.","color.sub":"Sub color of the preset: a gray tinted toward the main color, lime-gray by default. Secondary buttons fill with it, and tags and chips sit on its subtle step.","color.danger":"Destructive actions. Text on the fill uses danger.on.","color.sequential-main":"Brand light-green ramp for magnitude, low to high. Use when one brand-colored heatmap is the story; the blue sequential ramp stays the default.","color.series":"Categorical slots in fixed order. Validated: adjacent CVD ΔE ≥ 9.1, normal-vision ΔE ≥ 19.6. Slots 2 to 5 sit below 3:1 on the off-white surface, so charts ship direct labels or a table view. · Same hues as light, stepped for the dark surface. Validated: adjacent CVD ΔE ≥ 8.4, normal-vision ΔE ≥ 19.3, all ≥ 3:1.","color.sequential":"One hue, low to high magnitude. · Inverted for dark: the step nearest the surface means low.","color.status":"Reserved for state. Always paired with an icon and a label.","color.code":"Code sits in an inset well on the page tone, one step below the card around it; every syntax role clears 4.5:1 on it in both themes.","color.delta":"Text color for a change whose direction is good or bad.","layout.compact":"Tighter layout for screens that put content first, such as a built SDUI app. An element with data-density=\"compact\" swaps these in for inset, gap, section and stack.","letter-spacing":"Tracking in em, applied as calc(value * 1em)."},"catalog":[{"name":"--color-neutral-0","path":"color.neutral.0","type":"color","layer":"primitive","values":{"all":"#ffffff"},"chains":{"all":[]}},{"name":"--color-neutral-25","path":"color.neutral.25","type":"color","layer":"primitive","values":{"all":"#fcfcfb"},"chains":{"all":[]}},{"name":"--color-neutral-50","path":"color.neutral.50","type":"color","layer":"primitive","values":{"all":"#f9f9f7"},"chains":{"all":[]}},{"name":"--color-neutral-75","path":"color.neutral.75","type":"color","layer":"primitive","values":{"all":"#f6f5f2"},"chains":{"all":[]}},{"name":"--color-neutral-100","path":"color.neutral.100","type":"color","layer":"primitive","values":{"all":"#f0efec"},"chains":{"all":[]}},{"name":"--color-neutral-125","path":"color.neutral.125","type":"color","layer":"primitive","values":{"all":"#ecebe7"},"chains":{"all":[]}},{"name":"--color-neutral-150","path":"color.neutral.150","type":"col